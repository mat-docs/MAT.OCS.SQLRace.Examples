<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- SqlRaceApiVersion is defined in Directory.Build.props at the repo root. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
    <!--
      Floating, not pinned, and not left to come transitively either.

      MESL.SQLRace.API brings Roslyn with it, but the version it requires tracks
      whatever the SQL Race solution consumed at build time - the build rewrites
      the nuspec dependency versions to match. That floor moves in both
      directions: a pinned 4.8.0 broke with NU1605 the moment a build required
      4.9.2, and dropping the reference to take the API's version broke the
      other way, because an older release pins 4.3.1 which has no
      LanguageVersion.CSharp12.

      4.* always resolves at or above whatever the API asks for, so no downgrade
      is possible, and it always understands the language version the snippets
      are written in.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" />
    <PackageReference Include="MESL.SQLRace.API" Version="$(SqlRaceApiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\projects\csharp\SqlRace.Examples.Core\SqlRace.Examples.Core.csproj" />
    <ProjectReference Include="..\..\projects\csharp\FunctionLibrary\FunctionLibrary.csproj" />
    <ProjectReference Include="..\..\tools\FixtureGenerator\FixtureGenerator.csproj" />
  </ItemGroup>

</Project>
